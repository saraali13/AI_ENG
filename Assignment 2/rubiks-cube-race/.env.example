# Copy this file to ".env" and fill in your values. ".env" is git-ignored - never commit it or share the key.

# --- Shown in the website header ---
STUDENT_NAME=Syeda Sara Ali
ROLL_NUMBER=23k-0070

# --- OpenRouter: needed ONLY for the single live experiment ("Real" mode). Leave empty for mock/ollama/replay. ---
# The key stays on the server: never sent to the browser, never logged, never saved in results or cache.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# --- Experiment rules (the professor's numbers; the code refuses values above them) ---
MOVE_LIMIT=20                  # cannot be raised above 20
OPENROUTER_GLOBAL_LIMIT=65     # target; can never exceed the hard ceiling of 100
CLAUDE_REQUEST_LIMIT=5         # cannot be raised above 5 (failed requests and retries count)
MODEL_REQUEST_LIMIT=20         # per decision model (3 x 20 + 5 = 65)
OFFICIAL_SEED=2026             # fixes the 3-move start state, so reruns are free cache hits
STEP_TIMEOUT_SECONDS=120
LIVE_MAX_CONSECUTIVE_FAILURES=2   # live requests: at most ONE retry per move (retries are budgeted)
MAX_CONSECUTIVE_FAILURES=3        # mock / ollama

# --- Local free experiments with Ollama (never touch OpenRouter) ---
OLLAMA_BASE_URL=http://localhost:11434
# Use DIFFERENT local models per slot, otherwise identical requests are served once from the cache:
OLLAMA_MODEL=llama3.2
#OLLAMA_MODEL_JEV=llama3.2
#OLLAMA_MODEL_LUNA=qwen2.5:3b
#OLLAMA_MODEL_CLEF=gemma2:2b
#OLLAMA_MODEL_OPUS=phi3

# --- Other ---
MOCK_DELAY_SCALE=1.0
RESULTS_DIR=results
STATE_DIR=state                # persistent request counters + response cache. NEVER delete or reset this folder.

# Claude reply size cap. OpenRouter refuses a request whose max_tokens the key cannot afford (HTTP 402). Changing it makes a NEW cache key.
CHAT_MAX_TOKENS=1200
